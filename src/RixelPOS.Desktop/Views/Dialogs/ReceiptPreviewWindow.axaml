<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="using:RixelPOS.Desktop.Views.Dialogs"
                     xmlns:loc="using:RixelPOS.Desktop.Localization"
                     x:Class="RixelPOS.Desktop.Views.Dialogs.ReceiptPreviewWindow"
                     Title="{loc:Tr receipt.preview}"
                     Width="540" Height="780" MinWidth="420" MinHeight="520"
                     ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                     Background="{DynamicResource SurfaceBrush}">
  <dialogs:DialogWindow.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding ClosePreviewCommand}" />
  </dialogs:DialogWindow.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto" Margin="22" RowSpacing="12">
    <StackPanel Spacing="2">
      <TextBlock Text="{loc:Tr receipt.preview}" Classes="h2" />
      <TextBlock Text="{loc:Tr receipt.previewHint}" Classes="caption" />
    </StackPanel>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="18"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <SelectableTextBlock Text="{Binding PreviewText}" FontFamily="monospace"
                             FontSize="12.5" Foreground="#111111" TextWrapping="NoWrap" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Spacing="8">
      <TextBlock Text="{Binding StatusMessage}" Classes="caption" TextWrapping="Wrap"
                 IsVisible="{Binding HasStatus}" />
      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
        <Button Classes="primary big" Content="{loc:Tr checkout.printReceipt}"
                Command="{Binding PrintCommand}" HorizontalAlignment="Stretch" />
        <Button Grid.Column="1" Classes="soft big" Content="{loc:Tr checkout.exportPdf}"
                Command="{Binding ExportPdfCommand}" HorizontalAlignment="Stretch" />
        <Button Grid.Column="2" Classes="ghost" Content="{loc:Tr common.close}"
                Command="{Binding ClosePreviewCommand}" />
      </Grid>
    </StackPanel>
  </Grid>
</dialogs:DialogWindow>

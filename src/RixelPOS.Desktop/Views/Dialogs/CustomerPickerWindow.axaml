<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="using:RixelPOS.Desktop.Views.Dialogs"
                     xmlns:loc="using:RixelPOS.Desktop.Localization"
                     x:Class="RixelPOS.Desktop.Views.Dialogs.CustomerPickerWindow"
                     Title="{loc:Tr dialogs.selectCustomer}"
                     Width="560" Height="620" ShowInTaskbar="False"
                     WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="22" RowSpacing="12">
    <StackPanel Spacing="8">
      <TextBlock Text="{loc:Tr dialogs.selectCustomer}" Classes="h2" />
      <TextBox Text="{Binding SearchText}" Watermark="{loc:Tr dialogs.customerSearch}" />
    </StackPanel>
    <Border Grid.Row="1" Classes="soft" Padding="6">
      <ListBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="4,4">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Phone}" Classes="caption" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding TaxId}" Classes="caption" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <Button Classes="ghost" Content="{loc:Tr dialogs.noCustomer}" Command="{Binding WalkInCommand}" />
      <Button Grid.Column="2" Classes="ghost" Content="{loc:Tr common.cancel}" Command="{Binding CancelCommand}" />
      <Button Grid.Column="3" Classes="primary" Content="{loc:Tr common.select}" Command="{Binding ConfirmCommand}" />
    </Grid>
  </Grid>
</dialogs:DialogWindow>

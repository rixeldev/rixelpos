<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:RixelPOS.Desktop.Localization"
        xmlns:domain="using:RixelPOS.Domain.Common"
        x:Class="RixelPOS.Desktop.Views.LoginWindow"
        Title="RixelPOS"
        Icon="avares://RixelPOS/Assets/rixelpos.png"
        Width="1040" Height="700"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">
  <Grid ColumnDefinitions="1.05*,0.95*">
    <!-- Brand panel -->
    <Border Grid.Column="0" Background="#0B1118" Padding="54">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Top">
          <Image Source="avares://RixelPOS/Assets/rixelpos.png" Width="52" Height="52" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="RixelPOS" FontSize="24" FontWeight="Bold" Foreground="#F2F7FB" />
            <TextBlock Text="by RixelDev" FontSize="12" Foreground="#00C2A8" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="22" MaxWidth="420">
          <TextBlock Text="{loc:Tr app.tagline}" FontSize="34" FontWeight="SemiBold"
                     Foreground="#F2F7FB" TextWrapping="Wrap" LineHeight="42" />
          <TextBlock Text="{loc:Tr login.heroSub}"
                     Foreground="#93A6BA" TextWrapping="Wrap" FontSize="15" LineHeight="24" />
          <StackPanel Spacing="14" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="34" Height="34" CornerRadius="10" Background="#103B37">
                <TextBlock Text="✓" Foreground="#00C2A8" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{loc:Tr login.featureOffline}" Foreground="#D5E0EA" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="34" Height="34" CornerRadius="10" Background="#103B37">
                <TextBlock Text="⌁" Foreground="#00C2A8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{loc:Tr login.featureHardware}" Foreground="#D5E0EA" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="34" Height="34" CornerRadius="10" Background="#103B37">
                <TextBlock Text="◈" Foreground="#00C2A8" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{loc:Tr login.featureData}" Foreground="#D5E0EA" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{x:Static domain:Branding.ProductName}" Foreground="#5F7182" FontSize="12" />
          <TextBlock Text="{x:Static domain:Branding.Version}" Foreground="#5F7182" FontSize="12" />
          <TextBlock Text="·" Foreground="#5F7182" FontSize="12" />
          <TextBlock Text="{x:Static domain:Branding.Company}" Foreground="#5F7182" FontSize="12" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Login panel -->
    <Border Grid.Column="1" Background="{DynamicResource AppBgBrush}" Padding="46">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" MaxWidth="380" HorizontalAlignment="Center" Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding BusinessName}" FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr login.title}" Classes="h1" />
            <TextBlock Text="{loc:Tr login.subtitle}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>

          <!-- PIN mode -->
          <StackPanel Spacing="16" IsVisible="{Binding IsPinMode}">
            <Border Classes="soft" Padding="18,22" CornerRadius="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr login.enterPin}" Classes="caption" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PinDots}" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" MinHeight="38" Foreground="{DynamicResource TextBrush}" />
              </StackPanel>
            </Border>

            <Border Classes="dangerCard" IsVisible="{Binding HasError}">
              <TextBlock Text="{Binding ErrorMessage}" Classes="danger" TextWrapping="Wrap" FontSize="13" />
            </Border>

            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
              <Button Grid.Row="0" Grid.Column="0" Content="1" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="1" />
              <Button Grid.Row="0" Grid.Column="1" Content="2" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="2" />
              <Button Grid.Row="0" Grid.Column="2" Content="3" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="3" />
              <Button Grid.Row="1" Grid.Column="0" Content="4" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="4" />
              <Button Grid.Row="1" Grid.Column="1" Content="5" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="5" />
              <Button Grid.Row="1" Grid.Column="2" Content="6" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="6" />
              <Button Grid.Row="2" Grid.Column="0" Content="7" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="7" />
              <Button Grid.Row="2" Grid.Column="1" Content="8" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="8" />
              <Button Grid.Row="2" Grid.Column="2" Content="9" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="9" />
              <Button Grid.Row="3" Grid.Column="0" Content="⌫" Classes="pinKey ghost" Command="{Binding BackspaceCommand}" />
              <Button Grid.Row="3" Grid.Column="1" Content="0" Classes="pinKey" Command="{Binding AddDigitCommand}" CommandParameter="0" />
              <Button Grid.Row="3" Grid.Column="2" Content="→" Classes="pinKey primary" Command="{Binding SubmitPinCommand}" IsEnabled="{Binding CanSubmitPin}" />
            </Grid>

            <Button Content="{loc:Tr login.usePassword}" Classes="ghost" Command="{Binding TogglePasswordModeCommand}" />
          </StackPanel>

          <!-- Password mode -->
          <StackPanel Spacing="14" IsVisible="{Binding IsPasswordMode}">
            <Border Classes="dangerCard" IsVisible="{Binding HasError}">
              <TextBlock Text="{Binding ErrorMessage}" Classes="danger" TextWrapping="Wrap" FontSize="13" />
            </Border>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr common.username}" Classes="caption" />
              <TextBox Text="{Binding Username}" Watermark="{loc:Tr common.username}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr common.password}" Classes="caption" />
              <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="{loc:Tr common.password}" />
            </StackPanel>
            <Button Content="{loc:Tr login.signIn}" Classes="primary big" Command="{Binding SubmitPasswordCommand}" />
            <Button Content="{loc:Tr login.usePin}" Classes="ghost" Command="{Binding TogglePasswordModeCommand}" />
          </StackPanel>

          <TextBlock Text="{Binding ClockText}" Classes="caption" HorizontalAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.pinKey">
      <Setter Property="Height" Value="62" />
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.pinKey:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    </Style>
    <Style Selector="Button.pinKey.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>
</Window>

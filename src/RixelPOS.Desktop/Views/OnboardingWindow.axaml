<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:RixelPOS.Desktop.Localization"
        x:Class="RixelPOS.Desktop.Views.OnboardingWindow"
        Title="Bienvenido a RixelPOS" Width="760" Height="540"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        Icon="avares://RixelPOS/Assets/rixelpos.png">
  <Grid RowDefinitions="Auto,*,Auto" Margin="36">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Image Source="avares://RixelPOS/Assets/rixelpos.png" Width="36" Height="36" />
      <TextBlock Text="RixelPOS" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="by RixelDev" Classes="caption" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="22" MaxWidth="560" HorizontalAlignment="Center">
      <Border Width="92" Height="92" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
        <TextBlock x:Name="IconText" Text="▣" FontSize="40" Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock x:Name="TitleText" Text="Escanea y vende" FontSize="30" FontWeight="Bold" TextAlignment="Center" />
      <TextBlock x:Name="BodyText" Text="" FontSize="16" LineHeight="26" TextAlignment="Center"
                 TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
      <TextBlock x:Name="StepText" Text="1 / 3" Classes="caption" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="ghost" Content="{loc:Tr onboarding.skipTour}" Click="SkipClick" />
      <Button x:Name="NextButton" Grid.Column="3" Classes="primary big" Content="{loc:Tr common.next}" Click="NextClick" />
    </Grid>
  </Grid>
</Window>

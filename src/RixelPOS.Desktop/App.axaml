<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RixelPOS.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://RixelPOS/Assets/Styles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBgBrush" Color="#0A0F14" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#111925" />
          <SolidColorBrush x:Key="Surface2Brush" Color="#182333" />
          <SolidColorBrush x:Key="Surface3Brush" Color="#213043" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#0D141D" />
          <SolidColorBrush x:Key="BorderBrush" Color="#273749" />
          <SolidColorBrush x:Key="TextBrush" Color="#F2F7FB" />
          <SolidColorBrush x:Key="MutedBrush" Color="#93A6BA" />
          <SolidColorBrush x:Key="AccentBrush" Color="#00C2A8" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#19D9BF" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#103B37" />
          <SolidColorBrush x:Key="OnAccentBrush" Color="#041412" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FF5C6C" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1A21" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FFB020" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2E14" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
          <SolidColorBrush x:Key="SuccessSoftBrush" Color="#123528" />
          <SolidColorBrush x:Key="InfoBrush" Color="#5AA9FF" />
          <SolidColorBrush x:Key="InfoSoftBrush" Color="#132B44" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
          <SolidColorBrush x:Key="ChipBrush" Color="#1C2B3B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBgBrush" Color="#F2F6F9" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Surface2Brush" Color="#F1F5F8" />
          <SolidColorBrush x:Key="Surface3Brush" Color="#E5EDF3" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BorderBrush" Color="#D8E1E9" />
          <SolidColorBrush x:Key="TextBrush" Color="#101820" />
          <SolidColorBrush x:Key="MutedBrush" Color="#5D6E7E" />
          <SolidColorBrush x:Key="AccentBrush" Color="#00A892" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#00C2A8" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#D9F6F1" />
          <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DangerBrush" Color="#D93A4B" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE8EA" />
          <SolidColorBrush x:Key="WarningBrush" Color="#B77900" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF3D6" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#17895F" />
          <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DFF7EC" />
          <SolidColorBrush x:Key="InfoBrush" Color="#1E6FD9" />
          <SolidColorBrush x:Key="InfoSoftBrush" Color="#E3EFFC" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
          <SolidColorBrush x:Key="ChipBrush" Color="#EAF1F6" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

